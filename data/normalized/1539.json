 style=\"border-color: rgb(0, 0, 0); width: 86.2194%;\">\n<p><span style=\"font-weight: 400;\">How does it work?</span></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-color: rgb(0, 0, 0); width: 14.0448%;\">\n<p><strong>viii</strong></p>\n</td>\n<td style=\"border-color: rgb(0, 0, 0); width: 86.2194%;\">\n<p><span style=\"font-weight: 400;\">Fighting fraud</span></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-color: rgb(0, 0, 0); width: 14.0448%;\">\n<p><strong>ix</strong></p>\n</td>\n<td style=\"border-color: rgb(0, 0, 0); width: 86.2194%;\">\n<p><span style=\"font-weight: 400;\">Systems to avoid</span></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-color: rgb(0, 0, 0); width: 14.0448%;\">\n<p><strong>x</strong></p>\n</td>\n<td style=\"border-color: rgb(0, 0, 0); width: 86.2194%;\">\n<p><span style=\"font-weight: 400;\">Accepting the inevitable</span></p>\n</td>\n</tr>\n</tbody>\n</table>","contentHtml":"","options":[{"option":"i","text":"i"},{"option":"ii","text":"ii"},{"option":"iii","text":"iii"},{"option":"iv","text":"iv"},{"option":"v","text":"v"},{"option":"vi","text":"vi"},{"option":"vii","text":"vii"},{"option":"viii","text":"viii"},{"option":"ix","text":"ix"},{"option":"x","text":"x"}],"optionTitle":null,"allowReuse":false,"maxSelections":null,"image":null,"sort":0,"questions":[{"id":9570,"order":1,"type":"MATCHING_HEADINGS","text":"Paragraph B","content":"","options":null,"correctAnswer":"iv","correctAnswers":null,"explanationHtml":"<div data-page-id=\"VDmBdBXELoQ8jSxFLtQlxuOigAh\" data-lark-html-role=\"root\" data-docx-has-block-data=\"true\">\n<div>\n<table class=\"ace-table\" data-ace-table-col-widths=\"862\"><colgroup><col width=\"862\"></colgroup>\n<tbody>\n<tr>\n<td colspan=\"1\" rowspan=\"1\">\n<div class=\"ace-line ace-line old-record-id-Ui3cdNZrOoNev1xj6MRlW4Eagvb\">C&acirc;u 1:</div>\n<div class=\"ace-line ace-line old-record-id-XLWUduZIqopvr4xu18lliMTtgoe\"><u><strong>Bước 1</strong></u>: Đọc v&agrave; hiểu đoạn B:</div>\n<div class=\"ace-line ace-line 