"use client";

import type { QuestionSet, Answers, Mode } from "./types";
import QSetHeader from "./QSetHeader";
import AnswerStatus from "./AnswerStatus";

export default function LabelDiagram({
  qs,
  answers,
  onAnswer,
  mode,
}: {
  qs: QuestionSet;
  answers: Answers;
  onAnswer: (qId: number, val: string) => void;
  mode: Mode;
}) {
  const opts = qs.options ?? [];

  return (
    <div>
      <QSetHeader qs={qs} />
      {qs.image && (
        <div className="mb-4 text-center">
          <img src={`/api/image/${qs.image}`} alt="diagram" className="max-w-full mx-auto rounded border border-gray-200" />
        </div>
      )}
      {qs.contentHtml && (
        <div
          className="passage-html text-sm text-gray-700 mb-4 p-3 bg-gray-50 border border-gray-200 rounded-lg"
          dangerouslySetInnerHTML={{ __html: qs.contentHtml }}
        />
      )}
      {opts.length > 0 && (
        <div className="mb-4 p-3 bg-gray-50 border border-gray-200 rounded-lg">
          <div className="font-semibold text-gray-700 text-sm mb-2">Word Bank:</div>
          <div className="flex flex-wrap gap-2">
            {opts.map((opt) => (
              <span key={opt.option} className="px-2 py-1 bg-white border border-gray-300 rounded text-sm text-gray-700">
                {opt.text || opt.option}
              </span>
            ))}
          </div>
        </div>
      )}
      <div className="space-y-3">
        {qs.questions.map((q) => {
          const val = (answers[q.id] as string) ?? "";
          const correct = q.correctAnswer;
          const isReview = mode !== "exam";
          const ok = isReview && val.trim().toLowerCase() === (correct ?? "").trim().toLowerCase();

          return (
            <div key={q.id}>
              <div className="flex items-center gap-3 flex-wrap">
                <span className="font-bold text-blue-700 min-w-[2rem]">{q.order}.</span>
                {q.text && <span className="text-sm text-gray-800">{q.text}</span>}
                {opts.length > 0 ? (
                  <select
                    value={val}
                    disabled={isReview}
                    onChange={(e) => onAnswer(q.id, e.target.value)}
                    className={`border rounded px-2 py-1 text-sm min-w-[120px] outline-none ${
                      isReview
                        ? ok ? "border-green-400 bg-green-50" : "border-red-300 bg-red-50"
                        : "border-gray-300 focus:border-blue-500"
                    }`}
                  >
                    <option value="">-- Chọn --</option>
                    {opts.map((opt) => (
                      <option key={opt.option} value={opt.option}>{opt.text || opt.option}</option>
                    ))}
                  </select>
                ) : (
                  <input
                    type="text"
                    value={val}
                    disabled={isReview}
                    onChange={(e) => onAnswer(q.id, e.target.value)}
                    placeholder="Nhập..."
                    className={`border rounded px-2 py-1 text-sm min-w-[120px] outline-none ${
                      isReview
                        ? ok ? "border-green-400 bg-green-50" : "border-red-300 bg-red-50"
                        : "border-gray-300 focus:border-blue-500"
                    }`}
                  />
                )}
              </div>
              <div className="pl-8">
                <AnswerStatus mode={mode} userAnswer={val} correct={correct} explanationHtml={q.explanationHtml} />
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
}
